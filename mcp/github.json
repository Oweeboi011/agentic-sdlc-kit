{
  "type": "stdio",
  "command": "docker",
  "args": [
    "run",
    "-i",
    "--rm",
    "-e",
    "GITHUB_PERSONAL_ACCESS_TOKEN",
    "-e",
    "GITHUB_READ_ONLY",
    "ghcr.io/github/github-mcp-server:v2.1.0"
  ],
  "env": {
    "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_MCP_TOKEN}",
    "GITHUB_READ_ONLY": "1"
  },
  "tools": [
    "*"
  ]
}
