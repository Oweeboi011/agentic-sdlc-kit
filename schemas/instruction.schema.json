{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oweeboi011/agentic-sdlc-kit/schemas/instruction.schema.json",
  "title": "Instruction frontmatter (instructions/<name>.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["applyTo"],
  "properties": {
    "applyTo": {
      "description": "Comma-separated globs the rules apply to (Copilot applyTo), e.g. \"**/*.py\" or \"**\".",
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "description": "Render only for projects whose stack includes one of these. Omit for every project.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["python", "typescript-react", "bicep", "docker"] }
    }
  }
}
