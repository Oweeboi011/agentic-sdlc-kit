{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ava-innersource/agentic-sdlc-kit/schemas/astral-kit.schema.json",
  "title": "Project kit config (.github/astral-kit.yml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kit", "runtimes", "stack", "gate", "agents"],
  "properties": {
    "kit": {
      "description": "Kit version the project pins: a major tag (v0) or an exact release (v0.1.0).",
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$"
    },
    "runtimes": {
      "description": "Agent runtimes to render for.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["copilot", "claude-code"] }
    },
    "stack": {
      "description": "Languages and tools in the repo; picks instructions and reusable CI workflows.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["python", "typescript-react", "bicep", "docker"] }
    },
    "gate": {
      "description": "The project's own quality gate; the kit's ci-* workflows run it.",
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "description": "Kit agents to enable; each must exist under agents/ in the pinned kit.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" }
    },
    "templates": {
      "description": "Kit-managed template groups to render; default: all.",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["issue-forms", "pr-template", "githooks"] }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "environments"],
      "properties": {
        "target": { "enum": ["azure-container-apps", "azure-static-web-apps", "none"] },
        "environments": {
          "description": "GitHub Environments, in promotion order.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    }
  }
}
