{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oweeboi011/agentic-sdlc-kit/schemas/skill.schema.json",
  "title": "Skill frontmatter (skills/<name>/SKILL.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description"],
  "properties": {
    "name": {
      "description": "Skill id; must match the folder name.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "description": {
      "description": "What the skill does and when to use it; the runtime loads the skill on a match.",
      "type": "string",
      "minLength": 10,
      "maxLength": 1024
    }
  }
}
